# Copy to .env and fill in. Never commit .env.

# Bot token from @BotFather (required)
TELEGRAM_BOT_TOKEN=

# Telegram chat id of the shop owner (needed for owner commands and handoff)
OWNER_CHAT_ID=

# Shop knowledge file and SQLite log (optional, these are the defaults)
WARUNG_CONFIG=config/warung.json
DB_PATH=data/bot.sqlite3

# Smart answers (optional). Leave empty to run on rules only.
# Any OpenAI-compatible endpoint, e.g. https://api.openai.com/v1
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=
