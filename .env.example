# Copy to .env and fill in. Never commit .env.

# Required: bot token from @BotFather
BOT_TOKEN=

# Required: Telegram chat id of the shop owner (owner commands, handoff, daily summary).
# See DEPLOY.md for how to find it.
OWNER_CHAT_ID=

# Optional: smart answers from an OpenAI-compatible endpoint, e.g. https://api.openai.com/v1
# Fill in all three or leave all three empty (rules only).
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=
